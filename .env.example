# ===========================================================================
# MENTE.AI — Exemplo de variáveis de ambiente
# Copie este arquivo para .env.local e substitua os valores.
# ===========================================================================

# --- Banco de dados (TiDB Cloud) ---
# String de conexão MySQL com SSL. Obter em tidbcloud.com.
DATABASE_URL=mysql://usuario:senha@host:4000/mente_ai?ssl={"rejectUnauthorized":true}

# --- Autenticação ---
# Chave secreta para assinar JWTs (cookie mente_ai_token).
# Gere com: openssl rand -base64 48
JWT_SECRET=SUBSTITUIR_POR_CHAVE_FORTE

# --- Provedor de IA padrão ---
# Define qual LLM é usado por padrão: "anthropic" ou "openai".
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
# Chave da API em console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-api03-SUBSTITUIR
# Modelo Claude (opcional — fallback no código).
ANTHROPIC_MODEL=claude-opus-4-7

# --- OpenAI (fallback) ---
# Chave da API em platform.openai.com.
OPENAI_API_KEY=sk-SUBSTITUIR
# Modelo OpenAI (opcional — fallback no código).
OPENAI_MODEL=gpt-4o

# --- ElevenLabs (voz) ---
# Chave da API em elevenlabs.io.
ELEVENLABS_API_KEY=SUBSTITUIR

# --- Stripe (pagamentos) ---
# Chaves em dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=sk_test_SUBSTITUIR
# Webhook secret obtido ao configurar endpoint em dashboard.stripe.com/webhooks.
STRIPE_WEBHOOK_SECRET=whsec_SUBSTITUIR

# --- App ---
# URL pública da app. Em produção: https://ai-kids-flix.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Groq (provedor de IA alternativo) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Hume AI (voz e emoção) ---
HUME_API_KEY=your_hume_api_key_here

# --- CRON (geração automática de posts) ---
CRON_SECRET=your_cron_secret_here

# --- Nano Banana (provedor alternativo) ---
NANO_BANANA_API_KEY=your_nano_banana_key_here
NANO_BANANA_BASE_URL=your_nano_banana_url_here
NANO_BANANA_MODEL=your_nano_banana_model_here

# --- Checkout (API de pagamento) ---
CHECKOUT_API_KEY=your_checkout_api_key_here
CHECKOUT_AUTHENTICATOR=your_checkout_authenticator_here

# --- Site URL (para SEO e Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://mente-ai.vercel.app
