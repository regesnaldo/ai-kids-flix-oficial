# ─── MENTE.AI — Environment Variables ───────────────────────────────────────
# Copie este arquivo para .env.local e preencha com suas chaves reais.
# NUNCA comite .env.local ou .env com valores reais no Git.

# ── Banco de Dados (TiDB Cloud / MySQL) ────────────────────────────────────
DATABASE_URL=mysql://user:password@gateway01.us-east-1.tidbcloud.com:4000/mente_ai?ssl={"rejectUnauthorized":true}

# ── Autenticação (JWT) ─────────────────────────────────────────────────────
JWT_SECRET=seu-jwt-secret-super-seguro-aqui

# ── LLMs ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Voz / TTS (ElevenLabs) ──────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_DEFAULT=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_NEXUS=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_VOLT=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_AURORA=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_KAOS=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_CIPHER=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_ETHOS=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_LYRA=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_AXIOM=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_STRATOS=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_TERRA=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_PRISM=pNInz6obpgDQGcFmaJgB
NEXT_PUBLIC_ELEVENLABS_VOICE_ID_JANUS=pNInz6obpgDQGcFmaJgB

# ── Pagamentos (Stripe) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_51your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Infra / Deploy ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mente-ai.vercel.app
NODE_ENV=development
CRON_SECRET=seu-cron-secret-aqui

# ── Monitoramento (LangSmith) ───────────────────────────────────────────────
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key
LANGSMITH_PROJECT=mente-ai
LANGSMITH_TRACING=true

# ── Outros ──────────────────────────────────────────────────────────────────
HUME_API_KEY=your_hume_api_key
NANO_BANANA_API_KEY=your_nanobanana_api_key
NANO_BANANA_BASE_URL=https://api.nanobanana.ai/v1
NANO_BANANA_MODEL=pro-generator-v2
